# ParusDB — Interface (Next.js)
# Copier ce fichier en .env.local et renseigner les valeurs locales.
# Les secrets ne sont jamais commités (AGENTS.md §5).

# --- Supabase (stack self-hosted, gateway :8000 = Envoy/Kong) ---------------
# L'URL publique passe par la gateway de la stack Supabase self-hosted.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
# Clé publishable (publique par conception, côté navigateur uniquement).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Clé service_role : serveur uniquement, jamais NEXT_PUBLIC_, jamais commitée.
# Récupérable dans apps/supabase/.env (SERVICE_ROLE_KEY).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Sécurité applicative ----------------------------------------------------
# Clé de chiffrement AES-256-GCM des credentials (connecteurs, clés API LLM).
# Générer : openssl rand -hex 32
PARUSDB_ENCRYPTION_KEY=your-encryption-key

# --- Chat IA (Ollama + mcp-trino) --------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=ministral-3:3b
# Endpoint MCP Streamable HTTP de mcp-trino (lecture seule sur Trino).
MCP_TRINO_URL=http://localhost:8185/mcp
# Nombre maximal d'allers-retours LLM <-> outils MCP par message.
PARUSDB_AGENT_MAX_STEPS=8

# --- Data Lakehouse (Trino + Polaris) ----------------------------------------
# Trino durci (rbac_refonte.md §9) : HTTPS (certificat autosigné, port public
# 8453 — 8443 est publié par Kong) + authentification par mot de passe.
# TRINO_PASSWORD est le mot de passe du compte de service du BFF
# (TRINO_SERVICE_PASSWORD de apps/trino/.env, synchronisé par le setup racine).
TRINO_URL=https://localhost:8453
TRINO_USER=parus-app
TRINO_PASSWORD=your-trino-service-password
# Compte de service mcp-trino dans les règles d'access control régénérées
# (lecture seule globale — le périmètre du chat est borné côté serveur MCP).
TRINO_MCP_USER=parus-mcp
# Nom du compte outillage Trino (CLI, seed e2e) mentionné dans les règles
# d'access control régénérées (accès complet, hors chemin des requêtes des
# utilisateurs) — le mot de passe (TRINO_OPS_PASSWORD) ne quitte jamais
# apps/trino/.env : le BFF ne l'utilise pas.
TRINO_OPS_USER=parus-ops
# Dossier des fichiers de sécurité Trino (apps/trino/security, bind-monté dans
# le conteneur) : password.db (bcrypt) + rules.json (access control),
# régénérés depuis iam.grants par le BFF (lib/trino-security.ts).
TRINO_SECURITY_DIR=../trino/security
# Conteneur Trino redémarré par le BFF après création d'un catalogue
# (redémarrage automatique différé tant qu'une requête SQL est en cours).
TRINO_CONTAINER_NAME=parus-trino
# Dossier des fichiers .properties des catalogues Trino : un binding porte
# toujours le nom de son catalogue (apps/trino/catalog/<catalogue>.properties,
# généré par apps/trino/setup.sh ou à la création d'un catalogue par l'app —
# redémarrage Trino ensuite requis).
TRINO_CATALOG_DIR=../trino/catalog
POLARIS_API_URL=http://localhost:8181
POLARIS_REALM=POLARIS
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=your-polaris-root-secret
# Catalogue par défaut de la plateforme : le catalogue système, premier créé,
# non supprimable (badge « défaut » dans l'UI, garde dans la Server Action).
POLARIS_SYSTEM_CATALOG=parusdb
POLARIS_S3_BUCKET=parus-lakehouse
POLARIS_S3_ENDPOINT=http://rustfs:9000
POLARIS_S3_REGION=us-east-1
# Clés S3 (RustFS) : importées de apps/polaris/.env par le setup racine ;
# servent uniquement à l'affichage masqué dans /admin/informations (outils
# qui écrivent directement dans S3, ex. Airbyte).
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
# Hostname public exposé aux outils data externes (/admin/informations) :
# remplace les hostnames internes (ex. rustfs) dans les adresses de
# connexion. Vide = localhost.
PARUSDB_PUBLIC_HOST=

# --- Connecteurs ELT (moteur dlt, apps/dlt) ----------------------------------
# Image du runner dlt : construite localement (cd apps/dlt && sh run.sh build).
PARUSDB_DLT_IMAGE=parus-dlt-runner:1.0.0
# Réseau Docker des conteneurs jetables d'exécution (celui de la stack).
PARUSDB_DLT_NETWORK=supabase_default
