# dlt — moteur ELT de ParusDB (généré par setup.sh, jamais commité)

# --- Conteneurs jetables -----------------------------------------------------
# Image du runner (construite par `sh run.sh build`).
PARUSDB_DLT_IMAGE=parus-dlt-runner:1.0.0
# Réseau des conteneurs de run (réseau de la stack Supabase).
PARUSDB_DLT_NETWORK=supabase_default
# Volume Docker de l'état dlt (cursors incrémentaux des pipelines).
PARUSDB_DLT_STATE_VOLUME=parus-dlt-state
# Fréquence de scrutation des runs queued / CRON (secondes).
PARUSDB_DLT_POLL_SECONDS=5
# Nombre maximal de runs en parallèle.
PARUSDB_DLT_MAX_PARALLEL=2
# Délai maximal d'une exécution (secondes) avant arrêt du conteneur.
PARUSDB_DLT_RUN_TIMEOUT_SECONDS=14400

# --- Postgres applicatif (rôle dédié parus_dlt) -------------------------------
PARUSDB_DB_HOST=db
PARUSDB_DB_PORT=5432
PARUSDB_DB_NAME=postgres
PARUSDB_DB_USER=parus_dlt
# Généré par setup.sh (sql/01-dlt-role.sql).
PARUSDB_DB_PASSWORD=
# Rôle minimal requis (moindre privilège).
PARUSDB_DB_MIN_ROLE=authenticated

# --- Chiffrement des credentials ----------------------------------------------
# Identique à apps/nextjs/.env.local (importé par setup.sh) : le runner
# déchiffre les credentials AES-256-GCM chiffrés par le BFF.
PARUSDB_ENCRYPTION_KEY=

# --- Catalogue Iceberg (Polaris) ----------------------------------------------
# URI REST du catalogue (interne Docker, même valeur que Trino).
PARUSDB_POLARIS_URI=http://polaris:8181/api/catalog
PARUSDB_POLARIS_REALM=POLARIS
PARUSDB_POLARIS_CLIENT_ID=root
# Secret root Polaris (importé de apps/polaris/.env par setup.sh).
PARUSDB_POLARIS_CLIENT_SECRET=
# Nom du catalogue pyiceberg côté dlt (arbitraire, pas le nom du catalogue Polaris).
PARUSDB_ICEBERG_CATALOG_NAME=parus

# --- Object storage (RustFS) --------------------------------------------------
# Bucket du lakehouse (celui de Polaris) : base des locations des données.
PARUSDB_S3_BUCKET=parus-lakehouse
# Endpoint interne du RustFS — credentials S3 des données vendus par Polaris ;
# la paire ci-dessous ne sert qu'à la synchronisation d'état dlt
# (table _dlt_pipeline_state), importée depuis apps/polaris/.env par setup.sh.
PARUSDB_S3_ENDPOINT=http://rustfs:9000
PARUSDB_S3_REGION=us-east-1
PARUSDB_S3_ACCESS_KEY_ID=
PARUSDB_S3_SECRET_ACCESS_KEY=
