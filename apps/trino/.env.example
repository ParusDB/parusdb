############
# Apache Polaris (apps/polaris)
############
# URI de l'API Iceberg REST de Polaris, vue depuis le réseau Docker
# `supabase_default`. Le port interne du conteneur polaris est toujours 8181,
# quel que soit le port publié sur l'hôte.
POLARIS_URI=http://polaris:8181/api/catalog
# Catalogue Polaris utilisé comme warehouse (un catalogue par environnement,
# ex. dev, stg, prod — valeur importée de POLARIS_DEFAULT_CATALOG de
# apps/polaris/.env par setup.sh).
POLARIS_CATALOG_NAME=dev
# Catalogue système de la plateforme (importé de POLARIS_SYSTEM_CATALOG de
# apps/polaris/.env par setup.sh) : setup.sh génère un binding Trino par
# catalogue, le fichier portant le nom du catalogue.
POLARIS_SYSTEM_CATALOG=parusdb
# Realm Polaris.
POLARIS_REALM=POLARIS
# Credentials du principal Polaris utilisé par Trino (importés de
# apps/polaris/.env par setup.sh). À ce stade Trino s'appuie sur le principal
# root ; le RBAC applicatif (rôle actif, permissions granulaires par catalogue)
# viendra avec l'interface d'administration. Ne jamais commiter.
POLARIS_CLIENT_ID=
POLARIS_CLIENT_SECRET=

############
# Object storage RustFS (stack Supabase)
############
# Endpoint interne du RustFS (les credentials S3 sont vendus par Polaris,
# Trino n'en stocke aucun).
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1

############
# Trino
############
# Port exposé sur la machine hôte (UI web + API HTTP).
TRINO_PORT=8080
