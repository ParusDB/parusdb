############
# Apache Polaris (apps/polaris)
############
# URI de l'API Iceberg REST de Polaris, vue depuis le réseau Docker
# `supabase_default`. Le port interne du conteneur polaris est toujours 8181,
# quel que soit le port publié sur l'hôte.
POLARIS_URI=http://polaris:8181/api/catalog
# Catalogue Polaris utilisé comme warehouse (un catalogue par environnement,
# ex. dev, stg, prod — valeur importée de POLARIS_DEFAULT_CATALOG de
# apps/polaris/.env par setup.sh).
POLARIS_CATALOG_NAME=dev
# Catalogue système de la plateforme (importé de POLARIS_SYSTEM_CATALOG de
# apps/polaris/.env par setup.sh) : setup.sh génère un binding Trino par
# catalogue, le fichier portant le nom du catalogue.
POLARIS_SYSTEM_CATALOG=parusdb
# Realm Polaris.
POLARIS_REALM=POLARIS
# Credentials du principal Polaris utilisé par Trino (importés de
# apps/polaris/.env par setup.sh). À ce stade Trino s'appuie sur le principal
# root ; le RBAC applicatif (rôle actif, permissions granulaires par catalogue)
# viendra avec l'interface d'administration. Ne jamais commiter.
POLARIS_CLIENT_ID=
POLARIS_CLIENT_SECRET=

############
# Object storage RustFS (stack Supabase)
############
# Endpoint interne du RustFS (les credentials S3 sont vendus par Polaris,
# Trino n'en stocke aucun).
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1

############
# Trino
############
# Port HTTP interne (non exposé sur l'hôte : réservé à la communication
# interne Trino — discovery). Les clients se connectent en HTTPS ci-dessous.
TRINO_PORT=8080

############
# Durcissement Trino (HTTPS + authentification + access control)
############
# Trino est durci (rbac_refonte.md §9) : HTTPS avec certificat autosigné,
# authentification par fichier de mots de passe bcrypt et access control
# par règles JSON générées depuis iam.grants (apps/nextjs,
# TRINO_SECURITY_DIR). Les clients externes (BFF, mcp-trino, dbt, Power
# BI, JDBC) se connectent en HTTPS + mot de passe sur ce port.
# NB : le port hôte 8443 est déjà publié par la gateway Kong de la stack
# Supabase (supabase-kong) — Trino écoute en 8443 dans le conteneur et
# publie 8453 sur la machine.
TRINO_HTTPS_PORT=8453
# Compte de service du BFF Next.js (apps/nextjs). Non contraint par les
# règles d'access control : le RBAC applicatif (iam.has_grant) reste la
# garde côté éditeur SQL. Mot de passe généré par setup.sh, synchronisé
# vers apps/nextjs/.env.local (TRINO_PASSWORD) par le setup racine.
TRINO_SERVICE_USER=parus-app
TRINO_SERVICE_PASSWORD=
# Compte de service de mcp-trino (apps/mcp-trino) : lecture seule sur tous
# les catalogues (le périmètre réel du chat est borné par TRINO_ALLOWED_
# SCHEMAS côté serveur MCP et par le RBAC applicatif). Mot de passe importé
# par apps/mcp-trino/setup.sh.
TRINO_MCP_USER=parus-mcp
TRINO_MCP_PASSWORD=
# Secret partagé de la communication interne Trino (requis dès qu'une
# authentification est activée, même en mono-noeud). Généré par setup.sh.
TRINO_INTERNAL_SHARED_SECRET=
