############
# Dépendances Supabase (stack de apps/supabase)
############
# Host du Postgres Supabase sur le réseau Docker `supabase_default`.
POLARIS_DB_HOST=db
# Port du Postgres Supabase (valeur de POSTGRES_PORT dans apps/supabase/.env,
# resynchronisée par setup.sh).
POLARIS_DB_PORT=5432

############
# Persistance des métadonnées du catalogue (Postgres Supabase)
############
# Le rôle, la base et le mot de passe sont créés par setup.sh via
# sql/init-polaris-db.sql (idempotent). Base séparée de la base applicative
# Supabase : aucune métadonnée analytique ne vit dans `postgres`.
POLARIS_DB_NAME=polaris
POLARIS_DB_USER=polaris
# Généré par setup.sh (openssl rand -hex 24). Ne jamais commiter.
POLARIS_DB_PASSWORD=

############
# Apache Polaris
############
# Realm unique (convention Polaris) et principal root du realm.
POLARIS_REALM=POLARIS
POLARIS_ROOT_CLIENT_ID=root
# Généré par setup.sh (openssl rand -hex 24). Ne jamais commiter.
POLARIS_ROOT_CLIENT_SECRET=
# Ports exposés sur la machine hôte.
POLARIS_API_PORT=8181
POLARIS_MANAGEMENT_PORT=8182
# Catalogue d'environnement créé par setup.sh (AGENTS.md §10 : un catalogue par
# environnement, ex. dev, stg, prod). Laisser vide pour n'en créer aucun.
POLARIS_DEFAULT_CATALOG=dev

############
# Object storage RustFS (stack Supabase)
############
# Credentials importés de apps/supabase/.env (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD)
# par setup.sh. Ne jamais commiter.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Bucket dédié aux données Iceberg du lakehouse (créé par setup.sh).
# Contrainte de nommage S3 : minuscules, chiffres et tirets (pas de tiret bas).
POLARIS_S3_BUCKET=parus-lakehouse
# Endpoints RustFS : `endpointInternal` est utilisé par les services
# conteneurisés (Polaris, Trino, pipelines) ; `endpoint` est l'adresse annoncée
# aux clients externes. Tout notre outillage est conteneurisé : les deux
# pointent vers le service Docker `rustfs`.
S3_ENDPOINT=http://rustfs:9000
S3_ENDPOINT_INTERNAL=http://rustfs:9000
