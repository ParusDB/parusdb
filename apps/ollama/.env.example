############
# Ollama (apps/ollama)
############
# Port exposé sur la machine hôte (API HTTP : /api/chat, /api/generate...).
# Le port interne du conteneur est toujours 11434.
OLLAMA_PORT=11434

############
# Modèles
############
# Modèles téléchargés par `sh setup.sh` et `sh update.sh` (séparés par des
# espaces). ministral-3:3b : modèle Mistral compact, function calling
# (support des tools MCP) — tient dans les 6 Go de VRAM d'une
# RTX 3050 laptop.
OLLAMA_MODELS=ministral-3:3b
# Modèle par défaut du chat interactif (`sh run.sh cli`) et du test e2e
# Ollama ↔ mcp-trino (`sh run.sh test`).
OLLAMA_DEFAULT_MODEL=ministral-3:3b
