############
# Trino (cible des requêtes MCP)
############
# Hôte Trino vu depuis le réseau Docker `supabase_default` : alias compose du
# service `trino` de apps/trino (ne jamais exposer Trino directement aux LLM).
TRINO_HOST=trino
# Port interne Trino HTTPS (durcissement, spec fonctionnelle § « Intégration Technique » (durcissement Trino) — l'authentification
# exige TLS). Fixe, indépendant du port publié sur l'hôte.
TRINO_PORT=8443
# Compte de service mcp-trino (ligne bcrypt posée par apps/trino/setup.sh,
# règle read-only dans rules.json) : mot de passe importé depuis
# apps/trino/.env (TRINO_MCP_PASSWORD) par le setup.
TRINO_USER=parus-mcp
TRINO_PASSWORD=your-trino-mcp-password
# Catalogue Trino à interroger : un catalogue Polaris.
TRINO_CATALOG=dev
# Schéma par défaut (domaine fonctionnel, AGENTS.md §10 : schémas par domaine).
TRINO_SCHEMA=sales
# Trino durci : HTTPS avec certificat autosigné (généré par apps/trino/setup.sh).
TRINO_SCHEME=https
TRINO_SSL=true
# Certificat autosigné : validation ignorée (réseau privé, friction documentée
# dans /admin/informations). Le vrai périmètre du chat est borné par
# TRINO_ALLOWED_SCHEMAS + le RBAC applicatif.
TRINO_SSL_INSECURE=true

############
# Politique de requêtes
############
# Lecture seule : SELECT/SHOW/DESCRIBE/EXPLAIN uniquement. Le LLM ne peut
# jamais écrire dans le lakehouse par le chat.
TRINO_ALLOW_WRITE_QUERIES=false
# Timeout des requêtes (secondes).
TRINO_QUERY_TIMEOUT=60
# Schémas autorisés (liste catalog.schéma séparés par des virgules) : borne ce
# que le LLM voit et interroge. Le RBAC applicatif (rôle actif, permissions
# par catalogue) affinera cette liste par agent côté administration.
TRINO_ALLOWED_SCHEMAS=dev.sales

############
# Serveur MCP
############
# Port publié sur la machine hôte pour l'endpoint MCP Streamable HTTP /mcp.
# Le port interne du conteneur est toujours 8080.
MCP_TRINO_HTTP_PORT=8185
# URL publique de base (métadonnées MCP, endpoints affichés au démarrage).
MCP_URL=http://localhost:8185
