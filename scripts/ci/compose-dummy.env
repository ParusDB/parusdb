# CI uniquement : valeurs de substitution pour `docker compose config`.
#
# Les .env.example laissent volontairement vides les secrets générés par les
# setup.sh (openssl rand). Les fichiers compose utilisent l'interpolation
# stricte `${VAR:?...}`, qui échoue sur une valeur vide : ce fichier fournit
# des placeholders factices pour valider la configuration compose sans
# jamais contenir de vrai secret (voir .github/workflows/ci.yml, job
# « compose-config »).
#
# Usage : docker compose --env-file .env --env-file ../../scripts/ci/compose-dummy.env config -q

POLARIS_DB_PASSWORD=ci-placeholder
POLARIS_ROOT_CLIENT_SECRET=ci-placeholder
S3_ACCESS_KEY_ID=ci-placeholder
S3_SECRET_ACCESS_KEY=ci-placeholder
POLARIS_CLIENT_ID=ci-placeholder
POLARIS_CLIENT_SECRET=ci-placeholder
TRINO_SERVICE_PASSWORD=ci-placeholder
TRINO_MCP_PASSWORD=ci-placeholder
TRINO_OPS_PASSWORD=ci-placeholder
TRINO_INTERNAL_SHARED_SECRET=ci-placeholder
